{
  "name": "journalitea",
  "description": "Personal Tea Journal",
  "version": "0.2.3",
  "type": "module",
  "main": "dist-electron/main.js",
  "author": {
    "name": "Jonas Hundertmark",
    "email": "hundertmark@medialesson.de"
  },
  "scripts": {
    "compile:electron": "tsc --project tsconfig.node.json",
    "watch:electron": "tsc --project tsconfig.node.json --watch",
    "dev": "concurrently \"npm run watch:electron\" \"wait-on dist-electron/main.js && cross-env NODE_ENV=development vite\" \"wait-on dist-electron/main.js && wait-on http://localhost:5173 && cross-env NODE_ENV=development nodemon --watch dist-electron --exec electron .\"",
    "build": "npm run compile:electron && vite build && node scripts/copyAssets.mjs",
    "start": "npm run build && electron .",
    "app:dir": "npm run build && electron-builder --dir",
    "app:dist": "npm run build && electron-builder",
    "app:dist:win": "npm run build && electron-builder --win --x64",
    "postinstall": "electron-builder install-app-deps && patch-package"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^8.0.0",
    "@capacitor/android": "^8.0.2",
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.2",
    "@capacitor/filesystem": "^8.1.0",
    "@capacitor/ios": "^8.0.2",
    "@capacitor/status-bar": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capawesome/capacitor-file-picker": "^8.0.1",
    "@tailwindcss/vite": "^4.1.18",
    "better-sqlite3": "^12.6.2",
    "tailwindcss": "^4.1.18",
    "vue": "latest",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.6",
    "@vitejs/plugin-vue": "latest",
    "concurrently": "^9.2.1",
    "cross-env": "^10.1.0",
    "electron": "latest",
    "electron-builder": "^26.4.0",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9.39.2",
    "nodemon": "^3.1.11",
    "patch-package": "^8.0.0",
    "typescript": "^5.9.3",
    "vite": "latest",
    "wait-on": "^9.0.3"
  },
  "build": {
    "appId": "de.medialesson.journalitea",
    "files": [
      "dist/**",
      "dist-electron/**",
      "src/services/i18n/translations.csv",
      "package.json"
    ],
    "asarUnpack": [
      "**/better-sqlite3/**",
      "**/*.node"
    ],
    "mac": {
      "category": "public.app-category.productivity"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "category": "Productivity",
      "target": [
        "deb",
        "snap"
      ]
    }
  }
}
