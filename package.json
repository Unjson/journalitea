{
  "name": "minimal-electron-vue",
  "version": "1.0.0",
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "compile:electron": "tsc --project tsconfig.node.json",
    "watch:electron": "tsc --project tsconfig.node.json --watch",
    "dev": "concurrently \"npm run watch:electron\" \"wait-on dist-electron/main.js && NODE_ENV=development vite\" \"wait-on dist-electron/main.js && wait-on http://localhost:5173 && NODE_ENV=development nodemon --watch dist-electron --exec electron .\"",
    "build": "npm run compile:electron && vite build",
    "start": "npm run build && electron ."
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "better-sqlite3": "^12.6.0",
    "tailwindcss": "^4.1.18",
    "vue": "latest",
    "vue-i18n": "^11.2.8",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^25.0.6",
    "@vitejs/plugin-vue": "latest",
    "concurrently": "^9.2.1",
    "electron": "latest",
    "electron-rebuild": "^3.2.9",
    "eslint": "^9.39.2",
    "nodemon": "^3.1.11",
    "typescript": "^5.9.3",
    "vite": "latest",
    "wait-on": "^9.0.3"
  }
}
